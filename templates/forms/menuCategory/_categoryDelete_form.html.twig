<form class="admin-menu-form__delete-form" method="post" action="{{ path('app_menu_category_delete', {'id': menu_category.id}) }}" onsubmit="return confirm('Cette catégorie sera définitivement supprimer de la base de données. Confirmer la suppression (Les produits associés seront mis dans la catégorie de stockage)?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu_category.id) }}">
	<button class="admin-menu-form__delete-form__bttn category-theme">Supprimer cette catégorie</button>
</form>
