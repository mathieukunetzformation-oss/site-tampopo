{{ form_start(form, {'attr': {'class': 'admin-form__container'}}) }}

<div class="admin-form__container__edit">

	{{ form_row(form.title) }}


	{{ form_row(form.categoryIsDisplayed) }}
	{{ form_row(form.displayAsGrid) }}

	{{ form_row(form.description) }}

	{{ form_row(form.page) }}
	{{ form_row(form.orderInPage) }}

</div>

<button class="admin-form__container__confirm-edit-bttn category-theme">
	{{ button_label|default('Save') }}
</button>

{{ form_end(form) }}
