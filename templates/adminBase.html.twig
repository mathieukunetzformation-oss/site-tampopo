<!DOCTYPE html>
<html>

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>
			{% block title %}Dashboard Tampopo
			{% endblock %}
		</title>

		<link rel="icon" type="image/x-icon" href="/media/tampopo-icon.ico">
		{% block stylesheets %}
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c&display=swap" rel="stylesheet">
			<link href="https://fonts.googleapis.com/css2?family=Kodchasan:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>

	<body>
		{% block header %}
			<header class="adminHeader">
				<img class="adminHeader__logo" src="{{ asset('media/images/logos/logo_tampopo.jpg') }}" alt="">
				<h1 class="adminHeader__title">
					<a class="adminHeader__navbar__links__bttn" href="{{ path('app_admin') }}">Tableau de bord</a>
				</h1>
				<nav class="adminHeader__navbar" id="navbar">
					<div class="adminHeader__navbar__links">
						{% if app.request.attributes.get('_route') != 'app_adminMenuPage' %}
							<a class="adminHeader__navbar__links__bttn" href="{{ path('app_adminMenuPage') }}">Menu</a>
						{% endif %}
						{% if app.request.attributes.get('_route') != 'app_admin_reservation_index' %}
							<a class="adminHeader__navbar__links__bttn" href="{{ path('app_admin_reservation_index') }}">Réservations</a>
						{% endif %}
						{% if app.request.attributes.get('_route') != 'app_admin_contentblock_index' %}
							<a class="adminHeader__navbar__links__bttn" href="{{ path('app_admin_content_block_index')}}">Infos générales</a>
						{% endif %}
					</div>
				</nav>
			</header>
		{% endblock %}

		{% block main %}
			<main class="adminMain" data-page-type="adminLandingPage">
				<h2 class="adminMain__title">
					Bienvenue sur votre tableau de bord. Que souhaitez-vous faire ?
				</h2>
				<section class="adminMain__container edit-infos" id="infoSection">
					<a class="adminMain__container__link" href="{{ path('app_adminMenuPage') }}">
						<div class="adminMain__container__link__img">
							<i class="fa-brands fa-readme"></i>
						</div>
						<p class="adminMain__container__link__text">Gérer le Menu</p>
					</a>
					<a class="adminMain__container__link" href="{{ path('app_admin_reservation_index') }}">
						<div class="adminMain__container__link__img">
							<i class="fa-solid fa-calendar-days"></i>
						</div>
						<p class="adminMain__container__link__text">Gérer les réservations (wip)</p>
					</a>
					<a class="adminMain__container__link" href="{{ path('app_admin_content_block_index')}}">
						<div class="adminMain__container__link__img">
							<i class="fa-solid fa-info"></i>
						</div>
						<p class="adminMain__container__link__text">Gérer les informations affichés</p>
					</a>

				</section>
			</main>

		{% endblock %}
	</body>
</html></body></html>
