{% extends 'adminBase.html.twig' %}

{% block title %}Edit MenuPage
{% endblock %}

{% block main %}
	<main data-page-type="editPageForm" data-page-id={{form.vars.data.id ? form.vars.data.id : 'null'}}>
		<section class="admin-form">
			<h1 class="admin-form__title ">Édition de la page
				<span class="page-theme">
					{{menu_page.getTitle()}}</span>
			</h1>

			{{ include('forms/menuPage/_pageForm.html.twig', {'button_label': 'Appliquer les changements'}) }}

			<a class="admin-form__return-bttn page-theme" href="{{ path('app_adminMenuPage') }}">Retourner au menu</a>

			{% if not menu_page.isProtected() %}
				{{ include('forms/menuPage/_pageDelete_form.html.twig') }}
			{% endif %}
		</section>
	</main>
{% endblock %}
